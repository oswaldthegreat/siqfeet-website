<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register | Chrome Portal</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Poppins', sans-serif;
    }

    body {
      background: radial-gradient(circle at top left, #000, #111, #222);
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
    }

    .register-container {
      background: rgba(0, 0, 0, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      padding: 2.5rem;
      width: 360px;
      box-shadow: 0 0 40px rgba(255, 255, 255, 0.15);
      text-align: center;
    }

    .logo {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: linear-gradient(135deg, #aaa, #fff, #aaa);
      margin: 0 auto 1.5rem auto;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .logo img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
    }

    .register-container h2 {
      margin-bottom: 1.2rem;
      font-weight: 600;
      background: linear-gradient(90deg, #fff, #aaa, #fff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      text-align: left;
    }

    .input-field {
      position: relative;
    }

    .input-field input {
      width: 100%;
      padding: 0.9rem 2.8rem 0.9rem 1rem;
      border-radius: 8px;
      border: 1px solid #555;
      background: transparent;
      color: #fff;
      font-size: 0.95rem;
      transition: all 0.3s ease;
    }

    .input-field input:focus {
      outline: none;
      border-color: #ccc;
      box-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
    }

    .toggle-password {
      position: absolute;
      border-radius: 100px;
      top: 50%;
      right: 10px;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: #bbb;
      font-size: 1.0rem;
      transition: 0.3s ease;
      box-shadow: 0 0 0px rgba(255, 255, 255, 0.2);
    }

    .toggle-password:hover {
      background:none;
      animation: none;
      box-shadow: 0 0 0px rgba(0, 0, 0, 0.7);
    }

    .toggle-password:hover::before {
      animation: none;
    }

    /* ===== Chrome Button ===== */
    button {
      position: relative;
      overflow: hidden;
      padding: 0.9rem;
      border: none;
      border-radius: 8px;
      background: linear-gradient(90deg, #bbb, #fff, #bbb);
      color: #000;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: 0.3s;
      box-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
    }

    button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -75%;
      width: 50%;
      height: 100%;
      background: linear-gradient(
        120deg,
        transparent,
        rgba(255, 255, 255, 0.8),
        transparent
      );
      transform: skewX(-25deg);
    }

    button:hover::before {
      animation: chrome-shine 1.5s ease forwards;
    }

    @keyframes chrome-shine {
      0% {
        left: -75%;
      }
      100% {
        left: 125%;
      }
    }

    button:hover {
      background: linear-gradient(90deg, #fff, #aaa, #fff);
      box-shadow: 0 0 25px rgba(255, 255, 255, 0.4);
    }

    .footer-text {
      margin-top: 1.2rem;
      text-align: center;
      font-size: 0.85rem;
      color: #aaa;
    }

    .footer-text a {
      color: #fff;
      text-decoration: none;
      font-weight: 500;
    }

    .footer-text a:hover {
      text-decoration: underline;
    }

    /* Responsive */
    @media (max-width: 480px) {
      .register-container {
        width: 90%;
        padding: 2rem 1.5rem;
      }

      h2 {
        font-size: 1.4rem;
      }

      .input-field input {
        padding: 0.8rem 2.5rem 0.8rem 1rem;
        font-size: 0.9rem;
      }

      button {
        padding: 0.8rem;
      }
    }
  </style>
</head>
<body>
  <div class="register-container">
    <div class="logo">
      <img src="/logo/siqfit.png" alt="Logo" />
    </div>
    <h2>Create Account</h2>
    <% if (error && error.length > 0) { %>
      <p style="color: #ff6b6b; margin-bottom: 1rem;"><%= error[0] %></p>
    <% } %>
    <form action="/api/register/users" method="POST" onsubmit="handleSubmit(event)">
      <div class="input-field">
        <input type="text" name="username" placeholder="Username" required />
      </div>
      <div class="input-field">
        <input type="text" name="name" placeholder="Full Name" required />
      </div>
      <div class="input-field">
        <input type="email" name="email" placeholder="Email" required />
      </div>
      <div class="input-field">
        <input type="password" name="password" id="password" placeholder="Password" required />
        <button type="button" class="toggle-password" onclick="toggleVisibility('password', this)">👁️</button>
      </div>
      <div class="input-field">
        <input type="password" id="confirmPassword" placeholder="Confirm Password" required />
        <button type="button" class="toggle-password" onclick="toggleVisibility('confirmPassword', this)">👁️</button>
      </div>
      <button type="submit">Register</button>
    </form>
    <p class="footer-text">
      Already have an account? <a href="/login">Login</a>
    </p>
  </div>

  <script>
    function handleSubmit(e) {
      const password = document.getElementById("password").value;
      const confirmPassword = document.getElementById("confirmPassword").value;
      if (password !== confirmPassword) {
        e.preventDefault();
        alert("Passwords do not match!");
      }
    }

    function toggleVisibility(id, btn) {
      const field = document.getElementById(id);
      if (field.type === "password") {
        field.type = "text";
        btn.textContent = "🙈";
      } else {
        field.type = "password";
        btn.textContent = "👁️";
      }
    }
  </script>
</body>
</html>
