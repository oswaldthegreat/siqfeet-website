<script>
  //this is the script for the highlighting of the nav bar depending on the page
document.addEventListener("DOMContentLoaded", () => {
  const desktopLinks = document.querySelectorAll(".navbar .nav-link");
  const mobileLinks = document.querySelectorAll("#sideMenu a");

  const currentPath = window.location.pathname.replace(/\/$/, "") || "/";

  function activateLinks(links) {
    links.forEach(link => {

      if (link.getAttribute("href").startsWith("#")) return;

      const linkPath = new URL(link.href).pathname.replace(/\/$/, "");
      if (linkPath === currentPath ) {
        link.classList.add("active");
      }
    });
  }

  activateLinks(desktopLinks);
  activateLinks(mobileLinks);
});
</script>


<script>
  //this is the script for the homepage/products page mesaage
document.addEventListener("DOMContentLoaded", () => {
  const pageMessage = document.getElementById("pageMessage");
  const path = window.location.pathname.replace(/\/$/, "") || "/";

  let message = "";

  switch(path) {
    
    case "/products":
      message = "scroll to see our products! ";
      break;
    
    
    
    default:
      message = "";
  }

  pageMessage.textContent = message;
});
</script>


<script>
  //the java script for the scroll turning balck
  const navbar = document.querySelector(".custom-navbar");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 200) {
      navbar.classList.add("nav-scrolled");
    } else {
      navbar.classList.remove("nav-scrolled");
    }
  });
</script>


  <script>
    //java script forrr the monile hamburger
    const btn = document.getElementById("mobileMenuButton");
    const menu = document.getElementById("mobileMenu");

    btn.addEventListener("click", () => {
      menu.classList.toggle("show");
      btn.classList.toggle("active");
    });

    document.querySelectorAll("#mobileMenu a").forEach(link => {
      link.addEventListener("click", () => {
        menu.classList.remove("show");
        btn.classList.remove("active");
      });
    });
  </script>







