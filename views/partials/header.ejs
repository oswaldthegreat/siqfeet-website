/*HAMBURGER FOR THE MOBILE NAVBAR*/
@media (max-width: 768px) {
      #navbarNav {
        display: none !important; /* hide desktop nav on mobile */
      }

      .custom-navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 20px;
        background: black;
      }

      /* Hamburger (center between logo and cart) */
      .hamburger {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        cursor: pointer;
      }

      .hamburger span {
        width: 25px;
        height: 3px;
        background: white;
        border-radius: 4px;
        transition: all 0.3s ease;
      }

      /* Animate hamburger to X */
      .hamburger.active span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }

      .hamburger.active span:nth-child(2) {
        opacity: 0;
      }

      .hamburger.active span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }

      /* Mobile dropdown menu */
      .mobile-menu {
        position: fixed;
        top: 60px; /* adjust to navbar height */
        left: 0;
        width: 100%;
        background: black;
        display: flex;
        flex-direction: column;
        padding: 10px 0;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.35s ease;
        z-index: 999;
      }

      .mobile-menu a {
        padding: 12px 20px;
        color: white;
        font-size: 1.2rem;
        text-decoration: none;
        display: block;
      }

      .mobile-menu a:hover {
        background: #333;
      }

      .mobile-menu.show {
        max-height: 300px; /* adjust according to number of links */
      }
    }

     /* metalic */
    .metallic-text {
      font-size: 3rem;
      font-weight: bold;
      background: linear-gradient(270deg, #c0c0c0, #fff, #999, #fff, #c0c0c0);
      background-size: 600% 600%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: liquidMetal 4s ease infinite;
      text-align: center;
    }

    @keyframes liquidMetal {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

</style>




