<%- include("./partials/headerForProductDetails", { title: "Order Details" }) %>

<style>
  body {
    background: radial-gradient(circle at top left, #000, #111, #222);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    min-height: 100vh;
    padding: 2rem;
  }

  .order-details {
    background: rgba(0,0,0,0.7);
    border-radius: 16px;
    padding: 2rem;
    max-width: 800px;
    margin: auto;
    box-shadow: 0 0 30px rgba(255,255,255,0.1);
  }

  h1 {
    text-align: center;
    background: linear-gradient(90deg, #fff, #aaa, #fff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .info {
    margin-bottom: 1.5rem;
  }

  .info p {
    margin: 0.4rem 0;
    color: #ccc;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  li {
    background: rgba(255,255,255,0.05);
    border-radius: 8px;
    padding: 0.8rem 1rem;
    margin-bottom: 0.5rem;
  }

  .btn-back {
    display: block;
    width: fit-content;
    margin: 2rem auto 0;
    background: linear-gradient(90deg, #bbb, #fff, #bbb);
    color: #000;
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: 0.3s;
  }

  .btn-back:hover {
    background: linear-gradient(90deg, #fff, #aaa, #fff);
    box-shadow: 0 0 20px rgba(255,255,255,0.3);
  }

  .status {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    text-transform: capitalize;
  }

  .status.pending { background: rgba(255,215,0,0.2); color:#ffd700; }
  .status.paid { background: rgba(0,255,127,0.2); color:#00ff99; }
  .status.failed { background: rgba(255,99,71,0.2); color:#ff6666; }
  .status.shipped { background: rgba(0,191,255,0.2); color:#00bfff; }

</style>

<div class="order-details">
  <h1>Order Details</h1>

  <div class="info">
    <p><strong>Order ID:</strong> <%= order._id %></p>
    <p><strong>User:</strong> <%= order.user?.name || 'Unknown' %></p>
    <p><strong>Email:</strong> <%= order.user?.email || 'N/A' %></p>
    <p><strong>Status:</strong> 
      <span class="status <%= order.status %>"><%= order.status %></span>
    </p>
    <p><strong>Date:</strong> <%= order.createdAt.toLocaleString() %></p>
  </div>

  <h3>Items:</h3>
  <ul>
    <% order.items.forEach(item => { %>
      <li>
        <strong><%= item.productName || item.product?.name || 'Product' %></strong><br/>
        Quantity: <%= item.quantity %> |
        Price: KES <%= item.price.toFixed(2) %>
      </li>
    <% }) %>
  </ul>

  <p style="margin-top:1rem;font-weight:600;">Total: KES <%= order.total.toFixed(2) %></p>

  <h3 style="margin-top:1.5rem;">Payment Info:</h3>
  <% if (order.payment && order.payment.method) { %>
    <p><strong>Method:</strong> <%= order.payment.method %></p>
    <% if (order.payment.mpesa) { %>
      <p><strong>Mpesa Result:</strong> <%= order.payment.mpesa.resultDesc || 'N/A' %></p>
    <% } %>
  <% } else { %>
    <p>No payment data available.</p>
  <% } %>

  <a href="/api/admin/orders" class="btn-back">← Back to Orders</a>
</div>

<%- include("./partials/footer") %>
