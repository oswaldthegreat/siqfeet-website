<%- include("./partials/headerForProductDetails", { title: "My Orders" }) %>

<style>
  body {
    background: radial-gradient(circle at top left, #000, #111, #222);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 2rem 1rem;
  }

  .orders-container {
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 2rem;
    width: 90%;
    max-width: 900px;
    box-shadow: 0 0 40px rgba(255, 255, 255, 0.15);
    margin: 2rem auto;
  }

  .orders-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .orders-header h1 {
    font-weight: 600;
    font-size: 2rem;
    background: linear-gradient(90deg, #fff, #aaa, #fff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .order-card {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    transition: 0.3s;
  }

  .order-card:hover {
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
  }

  .order-card h3 {
    font-size: 1rem;
    font-weight: 500;
    color: #ccc;
  }

  .order-card p {
    color: #ddd;
    font-size: 0.95rem;
    margin: 0.4rem 0;
  }

  .order-card strong {
    color: #fff;
  }

  ul {
    list-style: none;
    padding: 0;
    margin-top: 0.6rem;
  }

  li {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 0.6rem 0.8rem;
    margin-bottom: 0.4rem;
    font-size: 0.9rem;
  }

  .total {
    font-weight: 600;
    background: linear-gradient(90deg, #fff, #aaa, #fff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-top: 0.6rem;
  }

  .empty-orders {
    text-align: center;
    font-size: 1.3rem;
    color: #bbb;
    margin-top: 3rem;
  }

  .status {
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    text-transform: capitalize;
    font-weight: 500;
    font-size: 0.85rem;
  }

  .status.pending {
    background: rgba(255, 215, 0, 0.2);
    color: #ffd700;
  }

  .status.paid {
    background: rgba(0, 255, 127, 0.2);
    color: #00ff99;
  }

  .status.failed {
    background: rgba(255, 99, 71, 0.2);
    color: #ff6666;
  }

  .status.shipped {
    background: rgba(0, 191, 255, 0.2);
    color: #00bfff;
  }

  .btn {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    background: linear-gradient(90deg, #bbb, #fff, #bbb);
    color: #000;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
    transition: 0.3s;
  }

  .btn:hover {
    background: linear-gradient(90deg, #fff, #aaa, #fff);
    box-shadow: 0 0 25px rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 700px) {
    .orders-container {
      padding: 1.2rem;
    }
    .orders-header h1 {
      font-size: 1.6rem;
    }
  }
</style>

<div class="orders-container">
  <div class="orders-header">
    <div class="logo"
      style="width:70px;height:70px;border-radius:50%;background:linear-gradient(135deg,#aaa,#fff,#aaa);margin:0 auto 1rem auto;display:flex;align-items:center;justify-content:center;overflow:hidden;">
      <img src="/logo/siqfit.png" alt="Logo" style="width:100%;height:100%;border-radius:50%;object-fit:cover;">
    </div>
    <h1>Hello <%= user.name %>, here are your orders</h1>
  </div>

  <% if (orders.length === 0) { %>
    <p class="empty-orders">You haven’t placed any orders yet 🛒</p>
  <% } else { %>
    <% orders.forEach(order => { %>
      <div class="order-card">
        <h3>Order ID: <%= order._id %></h3>
        <p>Status:
          <span class="status <%= order.status %>"><%= order.status %></span>
        </p>
        <p>Placed on: <%= order.createdAt.toLocaleString() %></p>

        <h4>Items:</h4>
        <ul>
          <% order.items.forEach(item => { %>
            <li>
              <%= item.product?.name || 'Product' %> — 
              Qty: <%= item.quantity %>, 

              Price: KES <%= item.price.toFixed(2) %>
              name: <%= item.productName %>
            </li>
          <% }) %>
        </ul>
        <p class="total">Total: KES <%= order.total.toFixed(2) %></p>
      </div>
    <% }) %>
  <% } %>

  <a href="/products" class="btn">Continue Shopping</a>
</div>

<%- include("./partials/footer") %>
