<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <style>
    body {
      background: radial-gradient(circle at top left, #000, #111, #222);
      color: #fff;
      font-family: 'Poppins', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding-top: 5rem;
    }

    .dashboard-container {
      background: rgba(0, 0, 0, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      padding: 2.5rem;
      width: 90%;
      max-width: 900px;
      box-shadow: 0 0 40px rgba(255, 255, 255, 0.15);
      text-align: center;
    }

    h1 {
      background: linear-gradient(90deg, #fff, #aaa, #fff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      font-size: 2rem;
      margin-bottom: 2rem;
      font-weight: 600;
    }

    .btn-container {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
      align-items: center;
    }

    .btn {
      padding: 1rem 2rem;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      font-weight: 600;
      font-size: 1rem;
      background: linear-gradient(90deg, #bbb, #fff, #bbb);
      color: #000;
      text-decoration: none;
      width: 80%;
      max-width: 400px;
      transition: 0.3s;
    }

    .btn:hover {
      background: linear-gradient(90deg, #fff, #aaa, #fff);
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
      transform: translateY(-3px);
    }

    .logo {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      margin: 0 auto 1rem auto;
      background: linear-gradient(135deg, #aaa, #fff, #aaa);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
    }

    .logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }
  </style>
</head>

<body>
  <div class="dashboard-container">
    <div class="logo">
      <img src="/logo/siqfit.png" alt="Logo">
    </div>

    <h1>Welcome MASTER <%= user %> 👑</h1>

    <div class="btn-container">
      <a href="api/admin/create-product" class="btn">➕ Create New Product</a>
      <a href="api/admin/products" class="btn">🧩 Update or Delete Product</a>
      <a href="api/admin/orders" class="btn">📦 View Orders</a>
    </div>
  </div>
</body>
</html>
