<%- include("./partials/header", { title: "Products" }) %>



<style>
  @media (max-width: 575px) {
  .product-list {
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  
}

</style>

<h2 style="font-family: font1;font-size: 3rem; margin-top: 5px; text-align: center; font-weight: 900;color: black;">All Our Products</h2>

<div class="product-list">
  <% products.forEach(p => { %>
   
    <div class="product-card">
      <a style="text-decoration: none;" href="/product_details/<%= p._id %>">
        <div class="image-wrapper">
          <% if (p.images && p.images.length > 0) { %>
            <img
              src="<%= p.images[0].replace('public\\', '').replace('public/', '') %>"
              alt="<%= p.name %>"
            class="main-image"
          >
          <% if (p.images[1]) { %>
            <img 
              src="<%= p.images[1].replace('public\\', '').replace('public/', '') %>" 
              alt="<%= p.name %>" 
              class="hover-image"
            >
          <% } %>
        <% } else { %>
          <img src="/images/no-image.png" alt="No image" class="main-image">
        <% } %>
      </div>

      <div class="product-info" >

        <p class="product-details-p" style="color: black; font-weight: 700;text-decoration: none;display: inline-block;"><%= p.name %></p> 
        
        <p class="product-details" style="display: inline-block;color: green;font-weight: 700;font-family: font1;">— $<%= p.price %></p><br>
      
        <p class="product-details" style="color: black;display: inline;"><%= p.description %></p>
        
        <br>
        <a href="/product_details/<%= p._id %>" style="color: rgb(0, 0, 0); text-decoration:wavy;">View Details</a>
      </div>

    </div>
    
  <% }) %>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<section id="contact" class="contact-section py-5" style="background-color: #111; color: #fff;">
  <div class="container text-center">
    <h2 class="mb-4" style="letter-spacing: 2px;">Get in Touch with <span style="color: #c0c0c0;">SIQ_FIT</span></h2>
    <p class="mb-5" style="color: #bbb;">Reach out to us directly through our official platforms 👇</p>

    <div class="row justify-content-center">
      <!-- Instagram -->
      <div class="col-md-3 mb-4">
        <a href="https://instagram.com/siqfeet" target="_blank" class="text-decoration-none" style="color: #fff;">
          <div class="card bg-dark border-0 shadow-sm p-4 hover-glow">
            <i class="bi bi-instagram" style="font-size: 40px; color: #E4405F;"></i>
            <h5 class="mt-3">Instagram</h5>
            <p style="color: #aaa;">@siqfeet</p>
          </div>
        </a>
      </div>

      <!-- WhatsApp -->
      <div class="col-md-3 mb-4">
        <a href="https://wa.me/254790511812?text=Hey%20SiqFit!%20I%20want%20to%20order%20something%20🔥" target="_blank" class="text-decoration-none" style="color: #fff;">
          <div class="card bg-dark border-0 shadow-sm p-4 hover-glow">
            <i class="bi bi-whatsapp" style="font-size: 40px; color: #25D366;"></i>
            <h5 class="mt-3">WhatsApp</h5>
            <p style="color: #aaa;">+254 790 511 812</p>
          </div>
        </a>
      </div>

      <!-- Email -->
      <div class="col-md-3 mb-4">
        <a href="mailto:contact@siqfit.com" class="text-decoration-none" style="color: #fff;">
          <div class="card bg-dark border-0 shadow-sm p-4 hover-glow">
            <i class="bi bi-envelope" style="font-size: 40px; color: #c0c0c0;"></i>
            <h5 class="mt-3">Email</h5>
            <p style="color: #aaa;">contact@siqfit.com</p>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hover-glow {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .hover-glow:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 20px rgba(192, 192, 192, 0.3);
  }

  .card {
    border-radius: 15px;
  }
</style>

<%- include("./partials/footer") %>
