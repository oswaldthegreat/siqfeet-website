<%- include("./partials/header", { title: "Products" }) %>

<style>
    .delete-btn {
  background: linear-gradient(135deg, #ffcc00, #ff9900);
  border: none;
  color: #000;
  font-weight: 600;
  border-radius: 8px;
  padding: 0.6rem 1.2rem;
  cursor: pointer;
  transition: 0.3s;
  box-shadow: 0 0 10px rgba(255, 215, 0, 0.3);
}

.delete-btn:hover {
  background: linear-gradient(135deg, #ff9900, #ffcc00);
  box-shadow: 0 0 20px rgba(255, 215, 0, 0.6);
  transform: translateY(-2px);
}

</style>

<h2 style="font-family: 'Oswald', sans-serif; margin-top: 5px; text-align: center; font-weight: 900;color: black;">All Products</h2>

<div class="product-list">
  <% products.forEach(p => { %>
   
    <div class="product-card">
      <a style="text-decoration: none;" href="/product_details/<%= p._id %>">
        <div class="image-wrapper">
          <% if (p.images && p.images.length > 0) { %>
            <img
              src="<%= p.images[0].replace('public\\', '').replace('public/', '') %>"
              alt="<%= p.name %>"
            class="main-image"
          >
          <% if (p.images[1]) { %>
            <img 
              src="<%= p.images[1].replace('public\\', '').replace('public/', '') %>" 
              alt="<%= p.name %>" 
              class="hover-image"
            >
          <% } %>
        <% } else { %>
          <img src="/images/no-image.png" alt="No image" class="main-image">
        <% } %>
      </div>

      <div class="product-info" >
        <p style="color: black; font-size: larger;font-weight: 700;text-decoration: none;display: inline-block;"><%= p.name %></p> <p style="display: inline-block;color: black;">— $<%= p.price %></p><br>
        <p style="color: black;display: inline;"><%= p.description %></p><br>
        <a href="/product_details/<%= p._id %>" style="color: rgb(0, 0, 0); text-decoration:wavy;">View Details</a>

        <form action="/api/admin/delete_product/<%= p._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?')">
    <button type="submit" class="delete-btn">🗑 Delete</button>
  </form>
      </div>

    </div>
    
  <% }) %>
</div>

<%- include("./partials/footer") %>
